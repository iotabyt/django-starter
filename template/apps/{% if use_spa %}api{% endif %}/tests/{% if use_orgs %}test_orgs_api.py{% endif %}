import pytest
from django.test import Client

from apps.orgs.models import Invite, Membership, Role
from apps.orgs.services import create_organization
from apps.users.models import User

pytestmark = pytest.mark.django_db


def test_post_without_csrf_token_is_rejected(user):
    client = Client(enforce_csrf_checks=True)
    client.force_login(user)
    response = client.post("/api/orgs/", {"name": "Acme"}, content_type="application/json")
    assert response.status_code == 403


def test_create_and_list_orgs(client, user):
    client.force_login(user)
    response = client.post("/api/orgs/", {"name": "Acme"}, content_type="application/json")
    assert response.status_code == 201
    assert response.json()["slug"] == "acme"

    response = client.get("/api/orgs/")
    assert response.status_code == 200
    assert response.json() == [
        {"id": response.json()[0]["id"], "name": "Acme", "slug": "acme", "role": "owner"}
    ]


def test_owner_can_invite(client, user):
    org = create_organization("Acme", user)
    client.force_login(user)
    response = client.post(
        f"/api/orgs/{org.slug}/invites",
        {"email": "New@Example.com", "role": "admin"},
        content_type="application/json",
    )
    assert response.status_code == 201
    assert response.json()["email"] == "new@example.com"
    assert Invite.objects.filter(organization=org, email="new@example.com").exists()


def test_invite_rejects_owner_role_and_existing_members(client, user):
    org = create_organization("Acme", user)
    client.force_login(user)
    url = f"/api/orgs/{org.slug}/invites"
    response = client.post(
        url, {"email": "x@example.com", "role": "owner"}, content_type="application/json"
    )
    assert response.status_code == 400
    response = client.post(url, {"email": user.email}, content_type="application/json")
    assert response.status_code == 400
    assert "already a member" in response.json()["detail"]


def test_plain_member_cannot_invite(client, user):
    owner = User.objects.create_user(email="owner@example.com", password="pw-123456")
    org = create_organization("Acme", owner)
    Membership.objects.create(organization=org, user=user, role=Role.MEMBER)
    client.force_login(user)
    response = client.post(
        f"/api/orgs/{org.slug}/invites", {"email": "x@example.com"}, content_type="application/json"
    )
    assert response.status_code == 403


def test_non_member_gets_404(client, user):
    owner = User.objects.create_user(email="owner@example.com", password="pw-123456")
    org = create_organization("Acme", owner)
    client.force_login(user)
    response = client.post(
        f"/api/orgs/{org.slug}/invites", {"email": "x@example.com"}, content_type="application/json"
    )
    assert response.status_code == 404
