# Local development settings. bin/setup copies this to .env with a fresh SECRET_KEY.
DEBUG=True
SECRET_KEY=insecure-dev-key-change-me
# Any Postgres works. If nothing is listening here, bin/setup and bin/dev start the
# Docker Compose one on this URL's port (change the port if 5432 is taken).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/{{ db_name }}
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://localhost:8000
TIME_ZONE=Africa/Accra
LOG_LEVEL=INFO

# Optional: Google sign-in (https://console.cloud.google.com/apis/credentials).
# Redirect URI: http://localhost:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
