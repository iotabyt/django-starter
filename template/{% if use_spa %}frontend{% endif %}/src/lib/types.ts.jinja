// Hand-written API types. For generated ones, run `just api-types` (src/lib/api-schema.ts).

export type Me = {
  id: number;
  email: string;
  name: string;
  is_staff: boolean;
  admin_url: string | null;
};
{% if use_orgs %}

export type Role = "owner" | "admin" | "member";

export type Org = {
  id: number;
  name: string;
  slug: string;
  role: Role;
  member_count: number;
  pending_invite_count: number;
};

export type Member = {
  id: number;
  user_id: number;
  email: string;
  name: string;
  role: Role;
  joined_at: string;
  is_me: boolean;
};

export type Invite = {
  id: number;
  email: string;
  role: Role;
  expires_at: string;
  invited_by: string | null;
};
{% endif %}
