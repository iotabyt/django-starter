{% if use_orgs %}
{% raw -%}
import { useMutation, useQueryClient, useSuspenseQuery } from "@tanstack/react-query";
import { createFileRoute, Link, useNavigate } from "@tanstack/react-router";
import { type FormEvent, useState } from "react";
import { EmptyState, Icon, type IconName, RoleBadge } from "../components/ui";
import { errorMessage, post } from "../lib/api";
import { orgsQuery } from "../lib/queries";
import type { Org } from "../lib/types";
import { meQuery } from "./__root";

export const Route = createFileRoute("/")({
  loader: ({ context }) => context.queryClient.ensureQueryData(orgsQuery),
  component: Dashboard,
});

function Stat({ icon, label, value }: { icon: IconName; label: string; value: number }) {
  return (
    <div className="card flex items-center gap-4 p-4 sm:p-5">
      <span className="hidden size-10 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600 sm:inline-flex">
        <Icon name={icon} />
      </span>
      <div>
        <p className="text-xs text-gray-500 sm:text-sm">{label}</p>
        <p className="text-2xl font-semibold tracking-tight">{value}</p>
      </div>
    </div>
  );
}

function Dashboard() {
  const { data: me } = useSuspenseQuery(meQuery);
  const { data: orgs } = useSuspenseQuery(orgsQuery);
  const queryClient = useQueryClient();
  const navigate = useNavigate();
  const [name, setName] = useState("");

  const createOrg = useMutation({
    mutationFn: (orgName: string) => post<Org>("/orgs/", { name: orgName }),
    onSuccess: async (org) => {
      setName("");
      await queryClient.invalidateQueries({ queryKey: orgsQuery.queryKey });
      await navigate({ to: "/orgs/$slug", params: { slug: org.slug } });
    },
  });

  function onSubmit(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    if (name.trim()) createOrg.mutate(name.trim());
  }

  const members = orgs.reduce((sum, org) => sum + org.member_count, 0);
  const pending = orgs.reduce((sum, org) => sum + org.pending_invite_count, 0);

  return (
    <div className="space-y-8">
      <div>
        <p className="text-sm font-medium text-indigo-600">Dashboard</p>
        <h1 className="mt-1 text-2xl font-bold tracking-tight">
          Welcome back{me.name ? `, ${me.name.split(" ")[0]}` : ""}
        </h1>
        <p className="mt-1 text-sm text-gray-600">Your organizations, their members and pending invites.</p>
      </div>

      <div className="grid grid-cols-3 gap-3 sm:gap-4">
        <Stat icon="building" label="Organizations" value={orgs.length} />
        <Stat icon="users" label="Members" value={members} />
        <Stat icon="envelope" label="Pending invites" value={pending} />
      </div>

      <div className="grid gap-6 lg:grid-cols-[1fr_20rem]">
        <section>
          <h2 className="mb-3 text-sm font-semibold text-gray-900">Organizations</h2>
          {orgs.length === 0 ? (
            <EmptyState icon="building" title="No organizations yet">
              Create one to invite your team, or ask someone to invite you.
            </EmptyState>
          ) : (
            <ul className="grid gap-4 sm:grid-cols-2">
              {orgs.map((org) => (
                <li key={org.id}>
                  <Link
                    to="/orgs/$slug"
                    params={{ slug: org.slug }}
                    className="card group block p-5 transition hover:border-indigo-300 hover:shadow-md"
                  >
                    <div className="flex items-start justify-between gap-3">
                      <div className="flex items-center gap-3">
                        <span className="logo-mark">{org.name.slice(0, 1).toUpperCase()}</span>
                        <div>
                          <p className="font-semibold">{org.name}</p>
                          <p className="text-sm text-gray-500">
                            {org.member_count} member{org.member_count === 1 ? "" : "s"}
                            {org.pending_invite_count > 0 &&
                              ` · ${org.pending_invite_count} pending invite${org.pending_invite_count === 1 ? "" : "s"}`}
                          </p>
                        </div>
                      </div>
                      <RoleBadge role={org.role} />
                    </div>
                  </Link>
                </li>
              ))}
            </ul>
          )}
        </section>

        <aside className="card h-fit p-5">
          <h2 className="font-semibold">New organization</h2>
          <form onSubmit={onSubmit} className="mt-4 space-y-4">
            <div className="space-y-1.5">
              <label htmlFor="org-name" className="label">
                Name
              </label>
              <input
                id="org-name"
                value={name}
                onChange={(event) => setName(event.target.value)}
                placeholder="Acme Ltd"
                className="input"
              />
            </div>
            <button type="submit" disabled={createOrg.isPending} className="btn-primary w-full">
              Create organization
            </button>
            {createOrg.error && <p className="text-sm text-red-600">{errorMessage(createOrg.error)}</p>}
          </form>
        </aside>
      </div>
    </div>
  );
}
{% endraw %}
{% else %}
{% raw -%}
import { useSuspenseQuery } from "@tanstack/react-query";
import { createFileRoute } from "@tanstack/react-router";
import { Icon, type IconName } from "../components/ui";
import { meQuery } from "./__root";

export const Route = createFileRoute("/")({
  component: Home,
});

const shortcuts: { href: string; icon: IconName; title: string; text: string }[] = [
  { href: "/settings/", icon: "user", title: "Profile", text: "Your name and how others see you." },
  { href: "/accounts/email/", icon: "envelope", title: "Email addresses", text: "Add, verify or change your email." },
  { href: "/accounts/2fa/", icon: "shield", title: "Security", text: "Two-factor authentication and recovery codes." },
];

function Home() {
  const { data: me } = useSuspenseQuery(meQuery);

  return (
    <div className="space-y-8">
      <div>
        <p className="text-sm font-medium text-indigo-600">Dashboard</p>
        <h1 className="mt-1 text-2xl font-bold tracking-tight">Hello, {me.name || me.email}</h1>
        <p className="mt-1 text-sm text-gray-600">
          This is the React app. Edit <code className="rounded bg-gray-100 px-1.5 py-0.5">frontend/src/routes/index.tsx</code> to
          get started.
        </p>
      </div>
      <div className="grid gap-4 sm:grid-cols-3">
        {shortcuts.map((item) => (
          <a key={item.href} href={item.href} className="card group p-6 transition hover:border-indigo-300 hover:shadow-md">
            <span className="inline-flex size-10 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600">
              <Icon name={item.icon} />
            </span>
            <h2 className="mt-4 font-semibold">{item.title}</h2>
            <p className="mt-1 text-sm text-gray-600">{item.text}</p>
          </a>
        ))}
      </div>
    </div>
  );
}
{% endraw %}
{% endif %}
