#!/bin/sh
# Run the app for development: Django, the Tailwind watcher, the worker (and Vite, with a
# frontend). Starts the Docker Postgres first unless DATABASE_URL is already reachable.
set -eu
cd "$(dirname "$0")/.."
# shellcheck source=bin/lib.sh
. bin/lib.sh

if [ ! -f .env ] || [ ! -d .venv ]; then
  fail "Not set up yet: run bin/setup first"
  exit 1
fi

load_dotenv
ensure_postgres
# Without this, Python buffers the output of web/worker/css until much later under honcho.
export PYTHONUNBUFFERED=1
# .env is already loaded above (shell variables win), so honcho mustn't load it again.
exec uv run honcho -e /dev/null -f Procfile.dev start
