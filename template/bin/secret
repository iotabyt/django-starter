#!/bin/sh
# Print one secret for .kamal/secrets: `bin/secret NAME`.
#
# Uses $NAME from the environment if it is set (e.g. in CI); otherwise reads NAME from
# .env.production (or the file in $KAMAL_ENV_FILE). An empty value is fine; a missing key
# is an error.
set -eu

name="${1:-}"
case "$name" in
  "" | [0-9]* | *[!A-Za-z0-9_]*)
    echo "usage: bin/secret NAME (letters, digits and underscores)" >&2
    exit 2
    ;;
esac

if eval "[ -n \"\${$name+set}\" ]"; then
  eval "printf '%s' \"\$$name\""
  exit 0
fi

file="${KAMAL_ENV_FILE:-.env.production}"
if [ ! -f "$file" ]; then
  echo "bin/secret: $name is not set and $file does not exist (copy .env.production.example)" >&2
  exit 1
fi

line=$(grep -E "^[[:space:]]*(export[[:space:]]+)?$name=" "$file" | tail -n 1 || true)
if [ -z "$line" ]; then
  echo "bin/secret: $name is missing from $file" >&2
  exit 1
fi

value=$(printf '%s' "${line#*=}" | tr -d '\r')
case "$value" in
  \"*\") value=${value#\"}; value=${value%\"} ;;
  \'*\') value=${value#\'}; value=${value%\'} ;;
esac
printf '%s' "$value"
