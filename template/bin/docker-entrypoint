#!/bin/sh
# Container entrypoint. For the web role (CMD starts with gunicorn) it waits for the
# database and runs migrations before starting. The worker role skips all this.
# Set RUN_MIGRATIONS=0 to skip migrations.
set -e

export DJANGO_SETTINGS_MODULE="${DJANGO_SETTINGS_MODULE:-config.settings.prod}"

if [ "$1" = "gunicorn" ] && [ "${RUN_MIGRATIONS:-1}" != "0" ]; then
  # On the first deploy the Postgres accessory may still be booting.
  python - <<'PY'
import sys
import time

import django

django.setup()

from django.db import connection
from django.db.utils import OperationalError

deadline = time.monotonic() + 30
while True:
    try:
        connection.ensure_connection()
        break
    except OperationalError as exc:
        if time.monotonic() > deadline:
            print(f"Database still unavailable after 30s: {exc}", file=sys.stderr)
            sys.exit(1)
        print("Waiting for the database...", file=sys.stderr)
        time.sleep(1)
connection.close()
PY
  python manage.py migrate --noinput
fi

exec "$@"
