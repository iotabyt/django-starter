# Kamal secrets. No values here: each line asks bin/secret, which reads the environment
# (CI) or .env.production (your laptop). Kamal runs the $(...) and expands earlier $VARS.
KAMAL_REGISTRY_PASSWORD=$(bin/secret KAMAL_REGISTRY_PASSWORD)

SECRET_KEY=$(bin/secret SECRET_KEY)
ADMIN_URL=$(bin/secret ADMIN_URL)
{% if database == "accessory" %}

POSTGRES_PASSWORD=$(bin/secret POSTGRES_PASSWORD)
DATABASE_URL=postgres://{{ db_name }}:$POSTGRES_PASSWORD@{{ project_slug }}-db:5432/{{ db_name }}_production
{% else %}
DATABASE_URL=$(bin/secret DATABASE_URL)
{% endif %}

RESEND_API_KEY=$(bin/secret RESEND_API_KEY)
DEFAULT_FROM_EMAIL=$(bin/secret DEFAULT_FROM_EMAIL)

GOOGLE_CLIENT_ID=$(bin/secret GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_SECRET=$(bin/secret GOOGLE_CLIENT_SECRET)

R2_BUCKET=$(bin/secret R2_BUCKET)
R2_ENDPOINT_URL=$(bin/secret R2_ENDPOINT_URL)
R2_ACCESS_KEY_ID=$(bin/secret R2_ACCESS_KEY_ID)
R2_SECRET_ACCESS_KEY=$(bin/secret R2_SECRET_ACCESS_KEY)

SENTRY_DSN=$(bin/secret SENTRY_DSN)
{% if database == "accessory" %}

# pgbackup-r2 (uncomment with the backup accessory in config/deploy.yml)
# AWS_ACCESS_KEY_ID=$(bin/secret BACKUP_AWS_ACCESS_KEY_ID)
# AWS_SECRET_ACCESS_KEY=$(bin/secret BACKUP_AWS_SECRET_ACCESS_KEY)
# HEARTBEAT_URL=$(bin/secret BACKUP_HEARTBEAT_URL)
# HEARTBEAT_FAIL_URL=$(bin/secret BACKUP_HEARTBEAT_FAIL_URL)
{% endif %}
