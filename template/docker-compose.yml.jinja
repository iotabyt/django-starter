# Local development only. Production runs Postgres as a Kamal accessory (or externally).
services:
  db:
    image: postgres:18
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: {{ db_name }}
    ports:
      - "127.0.0.1:5432:5432"
    volumes:
      # The PG18 image keeps its data in /var/lib/postgresql/<major>/, not .../data.
      - pgdata:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d {{ db_name }}"]
      interval: 2s
      timeout: 5s
      retries: 15

volumes:
  pgdata:
