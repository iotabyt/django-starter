# Local development only, and only if you have no Postgres of your own: bin/setup and
# bin/dev start it when DATABASE_URL isn't reachable. Production uses Kamal (or external).
services:
  db:
    image: postgres:18
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: {{ db_name }}
    ports:
      # bin/setup and bin/dev set DB_PORT from the port in DATABASE_URL.
      - "127.0.0.1:${DB_PORT:-5432}:5432"
    volumes:
      # The PG18 image keeps its data in /var/lib/postgresql/<major>/, not .../data.
      - pgdata:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d {{ db_name }}"]
      interval: 2s
      timeout: 5s
      retries: 15

volumes:
  pgdata:
