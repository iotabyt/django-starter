{% extends "base.html" %}
{% load ui %}

{% block title %}Organizations · {{ PROJECT_NAME }}{% endblock %}

{% block content %}
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold tracking-tight">Organizations</h1>
      <p class="mt-1 text-sm text-gray-600">Teams you belong to. Owners and admins can invite people and manage roles.</p>
    </div>
  </div>

  <div class="mt-8 grid gap-6 lg:grid-cols-[1fr_20rem]">
    <div>
      {% if orgs %}
        <ul class="grid gap-4 sm:grid-cols-2">
          {% for item in orgs %}
            <li>
              <a href="{% url 'orgs:detail' slug=item.org.slug %}" class="card group block p-5 transition hover:border-indigo-300 hover:shadow-md">
                <div class="flex items-start justify-between gap-3">
                  <div class="flex items-center gap-3">
                    <span class="logo-mark">{{ item.org.name|slice:":1"|upper }}</span>
                    <div>
                      <p class="font-semibold">{{ item.org.name }}</p>
                      <p class="text-sm text-gray-500">{{ item.member_count }} member{{ item.member_count|pluralize }}{% if item.pending_invites %} · {{ item.pending_invites }} pending invite{{ item.pending_invites|pluralize }}{% endif %}</p>
                    </div>
                  </div>
                  <span class="badge {% if item.membership.role == 'owner' %}badge-owner{% elif item.membership.role == 'admin' %}badge-admin{% endif %}">{{ item.membership.get_role_display }}</span>
                </div>
              </a>
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <div class="card flex flex-col items-center px-6 py-12 text-center">
          <span class="inline-flex size-12 items-center justify-center rounded-full bg-indigo-50 text-indigo-600">{% icon "building" "size-6" %}</span>
          <h2 class="mt-4 font-semibold">No organizations yet</h2>
          <p class="mt-1 max-w-sm text-sm text-gray-600">Create one to invite your team, or ask someone to invite you.</p>
        </div>
      {% endif %}
    </div>

    <aside class="card h-fit p-5">
      <h2 class="font-semibold">New organization</h2>
      <form method="post" class="mt-4 space-y-4">
        {% csrf_token %}
        <div class="field">
          <label for="{{ form.name.id_for_label }}">Name</label>
          {{ form.name }}
          {{ form.name.errors }}
        </div>
        <button type="submit" class="btn-primary w-full">Create organization</button>
      </form>
    </aside>
  </div>
{% endblock %}
