# Production secrets, read by bin/secret for `kamal deploy`. Copy to .env.production
# (gitignored) and fill in. Write values without quotes. Empty means "not used".

# A token of {{ registry_username }}'s with write:packages, for pushing images to
# ghcr.io/{{ github_owner }}/{{ project_slug }}
KAMAL_REGISTRY_PASSWORD=

# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Somewhere unguessable, e.g. a random path ending in a slash: manage-7f3k2/
ADMIN_URL=admin/
{% if database == "accessory" %}

# The Postgres accessory's password. Keep it URL-safe (it goes into DATABASE_URL):
# python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
{% else %}

# Your external Postgres, e.g. Neon: postgres://user:pass@host/db?sslmode=require
DATABASE_URL=
{% endif %}

# Email via Resend (https://resend.com/api-keys); the from address must be on a verified domain.
RESEND_API_KEY=
DEFAULT_FROM_EMAIL={{ project_name }} <noreply@{{ domain }}>

# Google sign-in. Redirect URI: https://{{ domain }}/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2 for user uploads. Leave R2_BUCKET empty to store media in the container.
R2_BUCKET=
# https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Error reporting (optional)
SENTRY_DSN=
{% if database == "accessory" %}

# pgbackup-r2 backup accessory (optional): an R2 token for the backups bucket
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_HEARTBEAT_URL=
BACKUP_HEARTBEAT_FAIL_URL=
{% endif %}
