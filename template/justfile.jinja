# Local development tasks. Deploys use Kamal directly: see the README.

default:
    @just --list

# First-time setup: deps, .env, Postgres, migrations, CSS
setup:
    uv sync
    [ -f .env ] || sed "s|^SECRET_KEY=.*|SECRET_KEY=$(uv run python -c 'import secrets; print(secrets.token_urlsafe(50))')|" .env.example > .env
{% if use_spa %}
    npm --prefix frontend install
{% endif %}
    docker compose up -d --wait db
    uv run python manage.py migrate
    uv run python manage.py tailwind build
    @if git rev-parse --git-dir >/dev/null 2>&1; then uv run pre-commit install; else echo "Not a git repo yet: run 'git init' then 'uv run pre-commit install'."; fi

# Run Django, the Tailwind watcher, the worker{{ ' and Vite' if use_spa else '' }}
dev: db
    uv run honcho -f Procfile.dev start

# Start local Postgres
db:
    docker compose up -d --wait db

migrate:
    uv run python manage.py migrate

makemigrations *args:
    uv run python manage.py makemigrations {{ '{{args}}' }}

superuser:
    uv run python manage.py createsuperuser

shell:
    uv run python manage.py shell

test *args:
    uv run pytest {{ '{{args}}' }}

# Ruff, basedpyright{{ ' and tsc' if use_spa else '' }}
lint:
    uv run ruff check .
    uv run ruff format --check .
    uv run basedpyright
{% if use_spa %}
    npm --prefix frontend run typecheck
{% endif %}

fmt:
    uv run ruff check --fix .
    uv run ruff format .
{% if use_spa %}

# Regenerate frontend/src/lib/api-schema.ts from the Ninja OpenAPI schema
api-types:
    uv run python manage.py export_openapi_schema --api apps.api.api.api --output openapi.json
    cd frontend && npx openapi-typescript ../openapi.json -o src/lib/api-schema.ts
{% endif %}

# Build the production image locally
build:
    docker build -t {{ project_slug }}:local .
