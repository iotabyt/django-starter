# Optional shortcuts: just is never required. bin/setup and bin/dev do the real work.
# Install with: uv tool install rust-just

default:
    @just --list

# First-time setup (or refresh): same as bin/setup
setup:
    bin/setup

# Run Django, the Tailwind watcher, the worker{{ ' and Vite' if use_spa else '' }}: same as bin/dev
dev:
    bin/dev

# Start local Postgres (Docker) unless DATABASE_URL is already reachable
db:
    sh -c '. bin/lib.sh && ensure_postgres'

migrate:
    uv run python manage.py migrate

makemigrations *args:
    uv run python manage.py makemigrations {{ '{{args}}' }}

superuser:
    uv run python manage.py createsuperuser

shell:
    uv run python manage.py shell

test *args:
    uv run pytest {{ '{{args}}' }}

# Ruff, basedpyright{{ ' and tsc' if use_spa else '' }}
lint:
    uv run ruff check .
    uv run ruff format --check .
    uv run basedpyright
{% if use_spa %}
    npm --prefix frontend run typecheck
{% endif %}

fmt:
    uv run ruff check --fix .
    uv run ruff format .
{% if use_spa %}

# Regenerate frontend/src/lib/api-schema.ts from the Ninja OpenAPI schema
api-types:
    uv run python manage.py export_openapi_schema --api apps.api.api.api --output openapi.json
    cd frontend && npx openapi-typescript ../openapi.json -o src/lib/api-schema.ts
{% endif %}

# Build the production image locally
build:
    docker build -t {{ project_slug }}:local .
