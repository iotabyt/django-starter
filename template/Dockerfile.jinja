# syntax=docker/dockerfile:1
{% if use_spa %}

# ---- Frontend: build the React app into frontend/dist ----
FROM node:22-slim AS frontend
WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build
{% endif %}

# ---- Python base ----
FROM python:3.13-slim AS base
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    PATH="/opt/venv/bin:$PATH"
COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /uvx /bin/
WORKDIR /app

# ---- Dependencies (cached until pyproject.toml or uv.lock change) ----
FROM base AS deps
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    uv sync --locked --no-dev --no-install-project

# ---- Runtime ----
FROM base AS runtime
# postgresql-client so `kamal dbshell` (manage.py dbshell) works.
RUN apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system app \
    && useradd --system --gid app --home-dir /app --no-create-home app

# Also covers `docker exec` / `kamal app exec`, which bypass the entrypoint.
ENV DJANGO_SETTINGS_MODULE=config.settings.prod

COPY --from=deps /opt/venv /opt/venv
COPY . .
{% if use_spa %}
COPY --from=frontend /frontend/dist /app/frontend/dist
{% endif %}

# Build CSS and collect static files. The env values only satisfy settings; nothing
# connects to a database here. The Tailwind binary is removed afterwards.
RUN SECRET_KEY=build-only-not-secret DATABASE_URL=postgres://build/build \
    sh -c "python manage.py tailwind build && python manage.py collectstatic --noinput" \
    && rm -rf .django_tailwind_cli

RUN mkdir -p /app/media && chown app:app /app/media
USER app

EXPOSE 8000
ENTRYPOINT ["/app/bin/docker-entrypoint"]
# Worker count comes from WEB_CONCURRENCY (set in config/deploy.yml).
CMD ["gunicorn", "config.wsgi", "--bind", "0.0.0.0:8000", "--access-logfile", "-", "--forwarded-allow-ips", "*"]
